# MPI Hosts File
# Format: hostname slots=count
# One line per node, '#' — комментарий.

# Локальный запуск (1 машина, 4 слота):
localhost slots=4

# Кластер (3 узла по 4 слота) — раскомментируйте и подставьте свои имена:
# node1 slots=4
# node2 slots=4
# node3 slots=4

# С конкретными IP:
# 192.168.1.10 slots=4
# 192.168.1.11 slots=4
# 192.168.1.12 slots=4