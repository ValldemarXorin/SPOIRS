# MPI Hosts File Example
# Format: hostname slots=count
# One line per node

# Local testing (1 machine, 4 cores):
localhost slots=4

# Cluster example (3 nodes, 4 cores each):
# node1 slots=4
# node2 slots=4
# node3 slots=4

# With specific IPs:
# 192.168.1.10 slots=4
# 192.168.1.11 slots=4
# 192.168.1.12 slots=4

# Usage:
# mpirun -np 12 -hostfile hosts python -m lab7.matmul_nonblocking --size 4000