# MPI Hosts File
# Format: hostname slots=count
# One line per node, '#' — комментарий.

# Локальный запуск (1 машина, 8 слотов):
localhost slots=8

# Кластер (3 узла по 8 слотов) — раскомментируйте и подставьте свои имена:
# node1 slots=8
# node2 slots=8
# node3 slots=8

# С конкретными IP:
# 192.168.1.10 slots=8
# 192.168.1.11 slots=8
# 192.168.1.12 slots=8